# Copy to .env (git-ignored) and adjust. Never commit real keys.
LLM_PROVIDER=mock            # mock | openai (any OpenAI-compatible endpoint)
LLM_MODEL=mock-1             # e.g. gpt-4o-mini, llama3.1 (Ollama), ...
LLM_BASE_URL=https://api.openai.com/v1   # Ollama: http://localhost:11434/v1
# LLM_API_KEY=sk-...
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=3
# The judge can use a different (stronger) model/provider than the system under test
# LLM_JUDGE_PROVIDER=openai
# LLM_JUDGE_MODEL=gpt-4o
# Comma-separated overlays; later files win. Add test_data/mock/faulty.yaml to simulate a bad model.
LLM_MOCK_RESPONSES=test_data/mock/responses.yaml
# Live providers: probabilistic failures become expected failures; the gate decides.
LLM_SOFT_FAIL=false
# Fail the Playwright run (exit code) when the quality gate fails.
LLM_GATE=false
# Playwright workers (respect provider rate limits with real APIs)
# LLM_WORKERS=2
LLM_LOG_LEVEL=info           # debug | info | warn | error | silent
